# This is a dedicated read-only host listener, not the WebAdmin Docker proxy.
# Bind only to the current Gateway LAN management address and interface.
# Configure values from the applied WAN/LAN topology; never the WAN interface.
VPNGW_PORT_STATUS_LAN_INTERFACE=YOUR_LAN_INTERFACE
VPNGW_PORT_STATUS_LAN_IP=YOUR_LAN_IPV4
VPNGW_PORT_STATUS_PORT=9443
