[Unit]
Description=Gateway VPN Multi persistent per-client fail-closed boot guards
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target networking.service NetworkManager.service systemd-networkd.service docker.service vpngw-policy-agent.service
Wants=network-pre.target
ConditionPathIsDirectory=/etc/vpngw-policy-agent/persistent-vpn

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/vpngw-vpn-boot-guard.py install
RemainAfterExit=yes
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
