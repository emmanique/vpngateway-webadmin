FROM node:22-alpine AS frontend
WORKDIR /build
COPY apps/web/package*.json apps/web/tsconfig.json apps/web/index.html ./
COPY apps/web/src ./src
COPY apps/web/tools ./tools
COPY apps/web/public ./public
RUN npm ci --no-audit --no-fund && npm run build
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx iproute2 nftables wireguard-tools curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --timeout 180 --retries 10 --no-cache-dir -r /app/requirements.txt
COPY apps/api/main.py apps/api/system_maintenance.py /app/
COPY apps/api/host_transition_plan.py /app/host_transition_plan.py
COPY scripts/network-topology.py scripts/multi-host-plan.py /app/
COPY --from=frontend /build/dist/ /usr/share/nginx/html/
COPY deploy/webadmin-nginx.conf /etc/nginx/sites-enabled/default
COPY deploy/webadmin-entrypoint.sh /usr/local/bin/webadmin-entrypoint
RUN chmod 755 /usr/local/bin/webadmin-entrypoint && mkdir -p /data
EXPOSE 80
CMD ["/usr/local/bin/webadmin-entrypoint"]
