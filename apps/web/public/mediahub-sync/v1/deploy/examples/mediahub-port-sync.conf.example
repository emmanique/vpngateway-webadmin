# Explicit opt-in; do not enable until the VPN Gateway has deployed
# the selected_host + lease-aware /api/v1/port-forward/desired endpoint.
MEDIAHUB_PORT_SYNC_ENABLE=0
# Stable host policy ID selected under Gateway -> Hosts and routes -> Edit host
MEDIAHUB_PORT_SYNC_POLICY_ID=stremio
# Registered physical MediaHub MAC, NOT a fixed IP.
MEDIAHUB_PORT_SYNC_HOST_MAC=aa:bb:cc:dd:ee:ff
# Explicit VPN Gateway management LAN IPv4, NOT the default router.
# Required even when the host routes to the Internet via another appliance.
MEDIAHUB_PORT_SYNC_GATEWAY_IP=YOUR_GATEWAY_LAN_IP
# Separate authenticated read-only status listener; do not confuse with
# the public bootstrap HTTPS reverse proxy on port 443.
MEDIAHUB_PORT_SYNC_API_PORT=9443
MEDIAHUB_PORT_SYNC_API_PATH=/api/v1/port-forward/desired
MEDIAHUB_PORT_SYNC_ROUTE_PROBE=1.1.1.1
MEDIAHUB_PORT_SYNC_CA_FILE=/etc/mediahub/gateway-ca.pem
# Distinct 0600 token from the Gateway's dedicated read-only host service.
MEDIAHUB_PORT_SYNC_TOKEN_FILE=/etc/mediahub/gateway-port-sync.token
# The bootstrap discovers the active Stremio Compose directory via Docker labels.
# The watcher only publishes an observation and NEVER edits .env or Docker.
